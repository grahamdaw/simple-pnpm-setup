# Check and use nvm if available
if [ -s $HOME/.nvm/nvm.sh ]; then
  . $HOME/.nvm/nvm.sh
  nvm use
fi

# Source a .env file (if it exists).
if [ -f .env ]; then
  # Export our environment variables (the -a flag will export all variables that are set)
  set -a
  . .env
  set +a
fi

# Enable pnpm
corepack enable pnpm
